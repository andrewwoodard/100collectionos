# Hosted Base44 backend (Vite /api/apps proxy + Vercel rewrite)
VITE_BASE44_APP_ID=69aee092656fb9813439389b
VITE_BASE44_APP_BASE_URL=https://100c-os.base44.app

# Neon (pulled from Vercel: vercel env pull)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Better Auth
BETTER_AUTH_SECRET=
# Must match the URL you open in the browser (use localhost, not 127.0.0.1)
BETTER_AUTH_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local only: treat Better Auth users as admin so the portal opens while data is still on Base44
# VITE_AUTH_DEV_ADMIN=true

# Optional: Base44 admin or service-role token for importing RLS-protected entities
# BASE44_ACCESS_TOKEN=
# BASE44_SERVICE_TOKEN=

# Base44-linked Supabase (service role for imports; do not commit real keys)
BASE44_SUPABASE_URL=
BASE44_SUPABASE_SERVICE_ROLE_KEY=
BASE44_SUPABASE_ANON_KEY=
