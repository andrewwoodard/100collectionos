# Hosted Base44 backend (Vite /api/apps proxy + Vercel rewrite)
VITE_BASE44_APP_ID=69aee092656fb9813439389b
VITE_BASE44_APP_BASE_URL=https://100c-os.base44.app

# Neon (pulled from Vercel: vercel env pull)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Better Auth
BETTER_AUTH_SECRET=
# Local: must match the URL you open (use localhost, not 127.0.0.1)
BETTER_AUTH_URL=http://localhost:5173
# Production fallback if the request host is missing:
# BETTER_AUTH_URL=https://portal.the100collection.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Vercel Blob — new property / AI-import images. Existing Sanity, Supabase,
# Base44, and Blob URLs keep being served from those hosts.
BLOB_READ_WRITE_TOKEN=

# Stripe (server only — never expose in VITE_ vars)
STRIPE_SECRET_KEY=

# Resend (password reset and transactional email)
RESEND_API_KEY=
# RESEND_FROM=The 100 Collection <hello@portal.the100collection.com>

# Local only: treat Better Auth users as admin so the portal opens while data is still on Base44
# VITE_AUTH_DEV_ADMIN=true

# Optional: Base44 admin or service-role token for importing RLS-protected entities
# BASE44_ACCESS_TOKEN=
# BASE44_SERVICE_TOKEN=

# Inbound webhook from theonehundredcollection.com / GHL application forms.
# GHL workflow should POST JSON to:
#   https://portal.the100collection.com/api/webhooks/main-site-application
# with header:
#   X-Webhook-Secret: <same value>
# MAIN_SITE_APPLICATION_WEBHOOK_SECRET=

# Base44-linked Supabase (service role for imports; do not commit real keys)
BASE44_SUPABASE_URL=
BASE44_SUPABASE_SERVICE_ROLE_KEY=
BASE44_SUPABASE_ANON_KEY=
