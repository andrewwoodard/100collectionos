{
  "rewrites": [
    {
      "source": "/api/apps/:path*",
      "destination": "/api/apps-handler?path=:path*"
    },
    {
      "source": "/api/auth/:path*",
      "destination": "/api/auth-handler?path=:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
