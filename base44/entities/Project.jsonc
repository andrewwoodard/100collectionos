{
  "name": "Project",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Project name"
    },
    "description": {
      "type": "string",
      "description": "Scope / summary"
    },
    "status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "blocked",
        "complete"
      ],
      "default": "not_started"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium"
    },
    "owner_name": {
      "type": "string",
      "description": "Display name of the admin owner"
    },
    "owner_email": {
      "type": "string",
      "format": "email",
      "description": "Email of the admin owner"
    },
    "owner_user_id": {
      "type": "string",
      "description": "User id of the admin owner"
    },
    "partner_id": {
      "type": "string",
      "description": "Optional linked partner"
    },
    "partner_name": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "archived": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "array",
      "description": "Chronological project notes / activity",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "author_email": { "type": "string" },
          "author_name": { "type": "string" },
          "content": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "default": []
    },
    "subitems": {
      "type": "array",
      "description": "Checklist / subitems under the project (Monday-style)",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "done": { "type": "boolean", "default": false },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "default": []
    },
    "board_order": {
      "type": "number",
      "description": "Sort order within a status group"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "role": "projects" } }
      ]
    },
    "read": {
      "$or": [
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "role": "projects" } }
      ]
    },
    "update": {
      "$or": [
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "role": "projects" } }
      ]
    },
    "delete": {
      "$or": [
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "role": "projects" } }
      ]
    }
  }
}
