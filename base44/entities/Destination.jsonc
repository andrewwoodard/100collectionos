{
  "name": "Destination",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Destination / market name (e.g. Nags Head)"
    },
    "slug": {
      "type": "string",
      "description": "URL slug for the public destination page on theonehundredcollection.com (e.g. nags-head)"
    },
    "is_exclusive": {
      "type": "boolean",
      "default": false,
      "description": "Whether this destination is flagged as exclusive. Toggled by admins from the Destinations tab."
    },
    "geocode_query": {
      "type": "string",
      "description": "Address or place name used to geocode this destination (e.g. \"Hilton Head Island, SC\" or \"Nags Head, NC\")."
    },
    "latitude": {
      "type": "number",
      "description": "Geocoded latitude for the destination map pin."
    },
    "longitude": {
      "type": "number",
      "description": "Geocoded longitude for the destination map pin."
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}