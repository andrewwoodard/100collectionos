{
  "name": "BrandAsset",
  "type": "object",
  "properties": {
    "label": {
      "type": "string",
      "description": "Display label for the logo (e.g. 'Primary Logo (PNG)')"
    },
    "description": {
      "type": "string",
      "description": "Short descriptor (e.g. 'Transparent background \u00b7 260x258')"
    },
    "url": {
      "type": "string",
      "description": "Public URL of the logo image file"
    },
    "filename": {
      "type": "string",
      "description": "Filename used when downloading (e.g. 'the-100-collection-logo.png')"
    },
    "background": {
      "type": "string",
      "default": "white",
      "description": "CSS background color for the preview swatch"
    },
    "light": {
      "type": "boolean",
      "default": false,
      "description": "When true, renders the preview on a dark navy swatch (for white/light logos)."
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order; lower numbers appear first."
    }
  },
  "required": [
    "label",
    "url",
    "filename"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}